[Unit]
Description=DynamoDB Local (in-memory) for TrueSignal
Requires=docker.service
After=docker.service

[Service]
ExecStartPre=-/usr/bin/docker rm -f dynamodb-local
# Loopback only. In-memory: a restart wipes every table, and truesignal-api
# (PartOf this unit) restarts with it to recreate and reseed them.
ExecStart=/usr/bin/docker run --rm --name dynamodb-local -p 127.0.0.1:8000:8000 --memory 768m \
    amazon/dynamodb-local -jar DynamoDBLocal.jar -inMemory -sharedDb
ExecStop=/usr/bin/docker stop dynamodb-local
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
