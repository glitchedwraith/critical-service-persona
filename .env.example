# Copy to .env and fill in. Used by ./start.sh.

# --- Amazon Bedrock (required for the AI pipeline) ---------------------------
# Credentials for an AWS account with Bedrock model access in this region.
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary (SSO / workshop) credentials:
AWS_SESSION_TOKEN=
# Optional: model override (default: Claude Haiku 4.5 inference profile)
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# --- Map tiles (optional) -----------------------------------------------------
# Free key from https://carto.com/basemaps/apikey. Without it the map uses Esri tiles.
VITE_CARTO_API_KEY=

# --- Ports (optional) ---------------------------------------------------------
# BACKEND_PORT=3000
# FRONTEND_PORT=5173
